# Normalize line endings in the repository; keep Windows scripts usable.
* text=auto

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.iss   text eol=crlf

# Binary assets
*.ico   binary
*.png   binary
*.bmp   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.dll   binary
*.exe   binary
*.pyd   binary
*.pyc   binary
*.zip   binary
